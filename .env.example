# ==========================================
# Paytm Payment Status API - Configuration
# ==========================================

# 1. DEMO RATE LIMIT
# Maximum free requests allowed per client IP before requiring an API key
DEMO_MAX_REQUESTS=5

# 2. AUTHORIZED PAID CLIENT KEYS (Comma-separated)
# Clients who pass one of these keys bypass the 5-request demo limit and get UNLIMITED requests.
# Example: API_KEYS=client_rahul_9921,client_priya_4821,bot_vip_pass_8829
API_KEYS=demo_paid_key_vip,client_live_key

# 3. SERVER CONFIGURATION (For local / VPS run)
PORT=5000
HOST=0.0.0.0
